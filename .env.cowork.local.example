# ============================================================================
# Cowork → Storyboard service credentials.
# Copy this file to ".env.cowork.local" and fill in the service-role key.
#
# ".env.cowork.local" is GITIGNORED and is NOT loaded by Next.js, so the secret
# never ships to the browser and never gets committed. Used ONLY by
# scripts/cowork.mjs when Claude writes scenes from here.
# ============================================================================

# Project API URL (same value as NEXT_PUBLIC_SUPABASE_URL).
SUPABASE_URL=https://kjndkdharwirccqpufpu.supabase.co

# SERVICE-ROLE key — Supabase → Settings → API Keys →
#   "Legacy anon, service_role API keys" tab → copy the `service_role` key.
# (A new-style `sb_secret_...` key also works — put it here instead.)
# This key has FULL database access and bypasses RLS. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=
