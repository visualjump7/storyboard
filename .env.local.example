# Supabase — copy this file to .env.local and fill in your project's values.
# Project URL and anon (public) key from: Supabase Dashboard → Project Settings → API.
# The anon key is safe to expose to the browser; Row Level Security protects data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# --- Service-role key: agent CLI (scripts/sb.mjs) + the public /share page ---
# The service_role key bypasses Row Level Security. It is SECRET: never commit it,
# never prefix it with NEXT_PUBLIC_, and never expose it to the browser.
# Found at: Supabase Dashboard → Project Settings → API → service_role.
# The deployed /share/{token} review page reads it server-side, so it must ALSO
# be set on Vercel (Project → Settings → Environment Variables, mark Sensitive).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# The email of the owner account in Supabase Auth — the CLI writes scenes for this user.
# (Alternatively set STORYBOARD_OWNER_USER_ID directly to skip the email lookup.)
STORYBOARD_OWNER_EMAIL=you@example.com

# Optional: your deployed app's URL so `sb share` prints full share links.
# STORYBOARD_APP_URL=https://your-app.vercel.app

# Simple shared gate password (typed on the login screen). Anyone with this
# value gets full owner access, so use a real secret here — not the example.
STORYBOARD_PASSWORD=choose-a-password
